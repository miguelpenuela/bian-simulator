# Copie este archivo a .env y sustituya los valores. Nunca suba .env al repositorio.

# PostgreSQL
POSTGRES_DB=bian_simulator
POSTGRES_USER=bian
POSTGRES_PASSWORD=cambie-esta-contrasena

# Perfil Spring: demo (carga el catálogo educativo) | prod
SPRING_PROFILES_ACTIVE=demo

# Usuario de demostración (solo perfiles dev/demo). Vacío = no se crea.
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=cambie-esta-contrasena-demo

# Sesión
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false

# Puerto publicado de la aplicación
APP_PORT=8081
